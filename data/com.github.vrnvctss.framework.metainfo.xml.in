<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.vrnvctss.framework</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Framework</name>
  <summary>Fast, native document viewer for GNOME</summary>
  <description>
    <p>
      Framework is a fast, native GNOME document viewer built on MuPDF.
      It renders PDF and DjVu files with aggressive pre-caching, a clean
      libadwaita interface, and zero bloat.
    </p>
  </description>
  <url type="homepage">https://github.com/vrnvctss/framework</url>
  <url type="bugtracker">https://github.com/vrnvctss/framework/issues</url>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="1.2.0" date="2026-04-11">
      <description>
        <p>The Velocity Engine update: dynamic resource pacing, memory clamps, and major performance fixes.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-04-07">
      <description>
        <p>State persistence, live page tracking, and bug fixes.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-04-06">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
  <launchable type="desktop-id">com.github.vrnvctss.framework.desktop</launchable>
</component>
