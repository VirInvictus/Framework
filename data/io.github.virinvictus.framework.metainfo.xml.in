<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component type="desktop-application">
  <id>io.github.virinvictus.framework</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Framework</name>
  <summary>Fast, tiling-first document viewer for Linux</summary>

  <developer id="io.github.virinvictus">
    <name>Brandon LaRocque</name>
  </developer>

  <description>
    <p>
      Framework is a fast, native document viewer for the modern Linux
      desktop, tiling-first on Wayland (Hyprland and any compositor) while
      staying at home under GNOME. It opens PDF, DjVu, EPUB, MOBI, AZW3, FB2,
      XPS, Markdown, and comic-book archives (CBZ, CB7, CBT, CBR) through
      MuPDF, DjVuLibre, libarchive, and a WebKitGTK reflow pipeline, and is
      engineered around a velocity-driven render cache that keeps scrolling
      smooth even on thousand-page textbooks.
    </p>
    <p>Features:</p>
    <ul>
      <li>Continuous vertical scroll with Wayland fractional-scaling support</li>
      <li>Parallel rendering across multiple CPU cores via independent MuPDF instances</li>
      <li>Persistent thumbnail tier so fast scrolling never shows blank pages</li>
      <li>Async progressive search with live "3 of 47" match counts</li>
      <li>Internal link navigation, browser-style back/forward history (Alt+Left / Alt+Right)</li>
      <li>Table-of-contents sidebar that follows the current page automatically</li>
      <li>Click-and-drag text selection, copy to clipboard, dynamic cursors</li>
      <li>Per-document state persistence: page, scroll, zoom, and rotation are restored on reopen</li>
      <li>Printing through the system print dialog</li>
      <li>Embedded-file extraction from PDFs with sanitized output paths</li>
      <li>Drag-and-drop file open</li>
    </ul>
    <p>
      Framework is a viewer, not an editor — no annotations, no save-as, no
      library manager. Every action is visible, every keystroke is fast.
    </p>
  </description>

  <launchable type="desktop-id">io.github.virinvictus.framework.desktop</launchable>

  <url type="homepage">https://github.com/VirInvictus/Framework</url>
  <url type="bugtracker">https://github.com/VirInvictus/Framework/issues</url>
  <url type="vcs-browser">https://github.com/VirInvictus/Framework</url>

  <categories>
    <category>Office</category>
    <category>Viewer</category>
    <category>GTK</category>
  </categories>

  <provides>
    <binary>framework</binary>
  </provides>

  <content_rating type="oars-1.1" />

  <recommends>
    <display_length compare="ge">600</display_length>
    <internet>offline-only</internet>
  </recommends>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <!-- Real captures from the Hyprland session (data/screenshots/, tracked).
       The first entry must carry type="default" and is what software centers
       feature. The raw URLs resolve on the GitHub side as soon as main is
       pushed; Flathub prefers 16:9 and these are 1500x980 — recrop before
       submission if the reviewer flags it (validation accepts them).
       16:9 target for a future recrop: 1500x844. -->
  <screenshots>
    <screenshot type="default">
      <caption>A 1,677-page textbook in continuous scroll</caption>
      <image>https://raw.githubusercontent.com/VirInvictus/Framework/main/data/screenshots/reading.png</image>
    </screenshot>
    <screenshot>
      <caption>Table-of-contents sidebar tracking the current section</caption>
      <image>https://raw.githubusercontent.com/VirInvictus/Framework/main/data/screenshots/contents.png</image>
    </screenshot>
    <screenshot>
      <caption>Asynchronous full-document search with live match counts</caption>
      <image>https://raw.githubusercontent.com/VirInvictus/Framework/main/data/screenshots/search.png</image>
    </screenshot>
    <screenshot>
      <caption>An EPUB reflowing in the dark reading theme with serif typography</caption>
      <image>https://raw.githubusercontent.com/VirInvictus/Framework/main/data/screenshots/reflow.png</image>
    </screenshot>
  </screenshots>

  <!-- Curated milestones, not every point release: AppStream is a changelog for
       users, and software centers show only the most recent entries. Full
       per-release detail lives in patchnotes.md. Add an entry here only when a
       release changes something a reader would notice. Never list a version
       that has not shipped. -->
  <releases>
    <release version="0.83.0" date="2026-09-04">
      <description>
        <p>Comic archives now show their ComicInfo metadata (series, writer, publisher, and more) in Document Properties, ebooks show a reading percentage in the header, and a fast scroll through a comic can no longer blank the rest of the book. Several smaller memory and theme fixes.</p>
      </description>
    </release>
    <release version="0.82.0" date="2026-07-17">
      <description>
        <p>AZW3 and KF8 books now render with their own publisher stylesheets, and publisher CSS no longer glares against a dark reading theme.</p>
      </description>
    </release>
    <release version="0.81.0" date="2026-07-17">
      <description>
        <p>Tiling-first geometry: fit-width and fit-page track the viewport as a tile resizes, and Framework no longer fights the compositor over the size of a tiled window.</p>
      </description>
    </release>
    <release version="0.80.0" date="2026-07-16">
      <description>
        <p>Framework is now plain GTK4 under its own Kanagawa Dragon stylesheet, with dark and light following the desktop portal preference. No libadwaita, and no GNOME dependency.</p>
      </description>
    </release>
    <release version="0.79.0" date="2026-07-16">
      <description>
        <p>EPUBs render with their own stylesheets and embedded fonts, with a "Publisher styles" toggle. Internal links and table-of-contents navigation work across every reflow format, and books cannot reach the network.</p>
      </description>
    </release>
    <release version="0.78.0" date="2026-07-16">
      <description>
        <p>Security hardening: scripts, inline event handlers, and javascript: URLs are stripped out of ebook HTML before it reaches the renderer, and the Landlock execute-permission drop is back.</p>
      </description>
    </release>
    <release version="0.75.0" date="2026-05-28">
      <description>
        <p>Markdown (.md) is a supported format, rendered with GitHub-flavored syntax and the same reading themes and typography as the other reflowable formats.</p>
      </description>
    </release>
    <release version="0.70.0" date="2026-05-28">
      <description>
        <p>Comics whose pages carry inconsistent embedded DPI now render at a uniform size, fixing the "every other page is a tiny thumbnail" look on some scanlated CBZ files.</p>
      </description>
    </release>
    <release version="0.69.0" date="2026-05-28">
      <description>
        <p>Fit-width sizes to the typical body page, so an oversized cover or a centerfold spread no longer shrinks every normal page. CBR comics learn their real page sizes in the background.</p>
      </description>
    </release>
    <release version="0.67.0" date="2026-05-27">
      <description>
        <p>AZW3 and KF8 books get a working table of contents, ebooks show a "% read" progress indicator, and a new toggle forces reflowable formats through the fixed-page renderer.</p>
      </description>
    </release>
    <release version="0.66.0" date="2026-05-27">
      <description>
        <p>Ctrl+F now searches inside EPUB, FB2, MOBI, AZW3, and plain-text documents, with match highlighting.</p>
      </description>
    </release>
    <release version="0.52.0" date="2026-05-02">
      <description>
        <p>MOBI support: Kindle .mobi files open with full text through a native parser.</p>
      </description>
    </release>
    <release version="0.42.0" date="2026-05-02">
      <description>
        <p>EPUB support on the reflow pipeline: real reflowed text with a proper table of contents, rather than a fixed page layout.</p>
      </description>
    </release>
    <release version="0.40.0" date="2026-05-02">
      <description>
        <p>The reflow pipeline arrives. Reflowable ebook formats get their own render path instead of being laid out as fixed pages.</p>
      </description>
    </release>
    <release version="0.38.0" date="2026-05-01">
      <description>
        <p>Landlock sandboxing: Framework drops filesystem execute permission at startup, so a malicious document that exploits a parser cannot launch a program.</p>
      </description>
    </release>
    <release version="0.21.0" date="2026-04-30">
      <description>
        <p>Automatic reload. Recompile a LaTeX or Typst document and Framework refreshes it, restoring the exact scroll position and zoom.</p>
      </description>
    </release>
    <release version="0.12.0" date="2026-04-30">
      <description>
        <p>Document Properties and Keyboard Shortcuts dialogs (Ctrl+? / F1).</p>
      </description>
    </release>
    <release version="0.6.0" date="2026-04-29">
      <description>
        <p>Honest pre-1.0 versioning. Earlier 1.x release labels are preserved in the patch notes as historical record.</p>
      </description>
    </release>
  </releases>

</component>
